{
  "name": "vendelier",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vendelier/app --filter=@vendelier/api",
    "build": "turbo run build",
    "start": "turbo run start --filter=@vendelier/app --filter=@vendelier/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "node --test tests/integration.test.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  }
}
