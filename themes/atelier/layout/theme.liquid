<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ shop.name }} · Atelier</title>
    <style>{{ stylesheet | raw }}</style>
  </head>
  <body>
    <main>
      <header>
        {% if shop.logo_url %}<img class="logo" src="{{ shop.logo_url | image_url }}" alt="" width="56" height="56">{% endif %}
        <div>
          {% if preview %}<p class="caption">Borrador de Atelier</p>{% endif %}
          <h1>{{ shop.name }}</h1>
        </div>
      </header>
      {{ content_for_layout | raw }}
    </main>
  </body>
</html>
