# Credenciales de referencia para la base de desarrollo local.
POSTGRES_PASSWORD=postgres_local
VENDELIER_MIGRATOR_PASSWORD=migrator_local
VENDELIER_APP_PASSWORD=app_local
DATABASE_URL=postgresql://vendelier_app:app_local@127.0.0.1:5432/vendelier
DATABASE_MIGRATION_URL=postgresql://vendelier_migrator:migrator_local@127.0.0.1:5432/vendelier
DATABASE_SHADOW_URL=postgresql://vendelier_migrator:migrator_local@127.0.0.1:5432/vendelier_shadow

# Un solo servidor para las interfaces y /api.
# VENDELIER_HOST=127.0.0.1
# VENDELIER_PORT=3000
# VENDELIER_ORIGIN=https://vendelier.example.com
# SESSION_COOKIE_SECURE=true

# Usa valores aleatorios distintos, de al menos 32 caracteres.
SESSION_SECRET=
DEMO_ADMIN_TOKEN=

# En local los archivos se guardan en .vendelier-local/media.
MEDIA_STORAGE=local
# MEDIA_ROOT=.vendelier-local/media
# MEDIA_S3_BUCKET=vendelier-media
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://minio.example.com
