{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["resources/kit_logos/*.svg"],
  "globalEnv": ["NEXT_PUBLIC_*"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "outputs": ["src/generated/**"]
    }
  }
}
