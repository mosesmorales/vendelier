{
  "name": "@vendelier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/create-app.d.ts",
      "import": "./dist/create-app.js"
    }
  },
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --env-file-if-exists=../../.env --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "transform": {}
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@vendelier/database": "workspace:*",
    "@vendelier/theme-engine": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
